<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA"
    tools:context=".QuickShiftHubActivity">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvWelcomeEmployee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome, Employee!"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvTotalItemsSold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:text="Total Items Sold Today: 0"
        android:textColor="#6C757D"
        android:textSize="16sp" />

    <!-- Flexible Spacer to push the 2x2 grid downward -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 2x2 COLOR-CODED GRID CONTAINER (Takes up ~Half the Screen) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignBounds">

        <!-- 1) Log New Sale (Green) -->
        <Button
            android:id="@+id/btnLogNewSale"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#2EC4B6"
            android:text="Log New\nSale"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 2) View Facturas (Blue) -->
        <Button
            android:id="@+id/btnViewFacturas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#3A86FF"
            android:text="View\nFacturas"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 3) Sales History (Orange) -->
        <Button
            android:id="@+id/btnSalesHistory"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#FF9F1C"
            android:text="Sales\nHistory"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 4) User Profile (Purple) -->
        <Button
            android:id="@+id/btnUserProfile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#8338EC"
            android:text="User\nProfile"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </GridLayout>

</LinearLayout>