<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    tools:context=".EmployeeProfileActivity">

    <!-- Profile Avatar (Clean Circular Style, No Blue Box) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProfilePhoto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:padding="16dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:background="#F0F0F0"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
        app:cornerSize="50dp"
        android:contentDescription="Employee Profile Picture" />

    <!-- Employee Name -->
    <TextView
        android:id="@+id/tvEmployeeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Employee Name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F1F1F"
        android:layout_marginBottom="4dp" />

    <!-- Employee Role -->
    <TextView
        android:id="@+id/tvEmployeeRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sales Associate"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <!-- User ID -->
    <TextView
        android:id="@+id/tvEmployeeUuid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID: 0000-0000"
        android:textSize="12sp"
        android:textColor="#999999"
        android:layout_marginBottom="32dp" />


    <!-- Spacer to push Logout button to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Logout"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#D32F2F"
        android:textColor="@android:color/white" />


</LinearLayout>